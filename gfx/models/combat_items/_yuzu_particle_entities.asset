# 时空粒子发射器的实体（源自 ASB Ironman 的中子鱼雷那一套）

entity = {
	name = "yuzu_particle_1_muzzle_entity"
	pdxmesh = "locator_mesh"
	
	default_state = "idle"
	state = { name = "idle" state_time = 0.9 looping = no
		event = { time = 0 particle = "yuzu_particle_1_muzzle" keep_particle = yes }
	}
}

entity = {
	name = "yuzu_particle_1_hit_entity"
	cull_radius = 1.0
	default_state = "idle"
	state = { name = "idle"
		start_event = { particle = "yuzu_particle_1_hit_effect" }
	}
	state = { name = "stop" state_time = 0.5 looping = no }
}

entity = {
	name = "yuzu_particle_1_shield_hit_entity"
	cull_radius = 1.0
	default_state = "idle"
	state = { name = "idle"
		start_event = { particle = "yuzu_particle_1_shield_hit_effect" sound = { soundeffect = shield_hit } }
	}
	state = { name = "stop" state_time = 0.5 looping = no }
}

entity = {
	name = "yuzu_particle_1_windup_entity"
