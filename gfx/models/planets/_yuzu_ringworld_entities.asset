# 柚子环世界行星实体
#
# 基线：原版 gfx/models/planets/_planetary_entities.asset 的
#       ringworld_habitable_entity_01_entity（Stellaris Cygnus v4.5.2，起始行 2991）。
# 只替换三个地表贴图；网格、音效、第二个 continental meshsettings、game_data、attach 全部保留。
#
# 行星类里写 entity = "yuzu_abyss_ringworld_planet" / "yuzu_sunset_ringworld_planet"，
# 引擎按 <name>_01_entity 解析到下面的实体。
# 贴图文件（yuzu_*_ringworld_{diffuse,normal,specular}.dds）放 gfx/models/planets/。

entity = {
	name = "yuzu_abyss_ringworld_planet_01_entity"
	cull_radius = 500.0
	pdxmesh = "ringworld_habitable_01_mesh"

	default_state = "idle"
	state = { name = "idle" state_time = 100 time_offset = { 0 100 }
		start_event = { trigger_once = yes sound = { soundeffect = "ringworld_hum_idle_01" stop_on_state_change = yes } }
		start_event = { trigger_once = yes sound = { soundeffect = "ringworld_hum_idle_02" stop_on_state_change = yes } }
	}
	state = { name = "construction"
	start_event = { trigger_once = yes sound = { soundeffect = "ringworld_construction_ambient" } }
	}

	meshsettings = {
		name = "pCube20Shape"
		index = 0
		texture_diffuse = "yuzu_abyss_ringworld_diffuse.dds"
		texture_normal = "yuzu_abyss_ringworld_normal.dds"
		texture_specular = "yuzu_abyss_ringworld_specular.dds"
		shader = "PdxMeshTerra"
	}

	meshsettings = {
		name = "polySurface9Shape"
		index = 0
		texture_diffuse = "continental_01_diffuse.dds"
		texture_normal = "continental_01_normals.dds"
		texture_specular = "continental_01_spec.dds"
		shader = "PdxMeshTerra"
	}

	game_data = {
		size = @ringworld_segment_size
		shader_type = ship
	}

	attach = { root = "ringworld_habitable_entity_01_clouds_entity" }
}

entity = {
	name = "yuzu_sunset_ringworld_planet_01_entity"
	cull_radius = 500.0
	pdxmesh = "ringworld_habitable_01_mesh"

	default_state = "idle"
	state = { name = "idle" state_time = 100 time_offset = { 0 100 }
		start_event = { trigger_once = yes sound = { soundeffect = "ringworld_hum_idle_01" stop_on_state_change = yes } }
		start_event = { trigger_once = yes sound = { soundeffect = "ringworld_hum_idle_02" stop_on_state_change = yes } }
	}
	state = { name = "construction"
	start_event = { trigger_once = yes sound = { soundeffect = "ringworld_construction_ambient" } }
	}

	meshsettings = {
		name = "pCube20Shape"
		index = 0
		texture_diffuse = "yuzu_sunset_ringworld_diffuse.dds"
		texture_normal = "yuzu_sunset_ringworld_normal.dds"
		texture_specular = "yuzu_sunset_ringworld_specular.dds"
		shader = "PdxMeshTerra"
	}

	meshsettings = {
		name = "polySurface9Shape"
		index = 0
		texture_diffuse = "continental_01_diffuse.dds"
		texture_normal = "continental_01_normals.dds"
		texture_specular = "continental_01_spec.dds"
		shader = "PdxMeshTerra"
	}

	game_data = {
		size = @ringworld_segment_size
		shader_type = ship
	}

	attach = { root = "ringworld_habitable_entity_01_clouds_entity" }
}
